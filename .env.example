# ─────────────────────────────────────────────
# Anthropic API — 채팅형 지식창고, 정책 후보 생성, 영향도 분석에 사용
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────
# Figma API — 화면설계서에서 정책 텍스트를 추출할 때 사용 (선택)
# 미설정 시 로컬로 내보낸 Figma 텍스트 파일만 파싱 가능
# ─────────────────────────────────────────────
FIGMA_ACCESS_TOKEN=
FIGMA_FILE_KEY=

# ─────────────────────────────────────────────
# 데이터 파이프라인 경로 (3단계: raw → staging → knowledge)
# ─────────────────────────────────────────────
RAW_DATA_DIR=./data/raw
STAGING_DATA_DIR=./data/staging
DATABASE_PATH=./data/knowledge/policy.json

NODE_ENV=development
