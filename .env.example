# ─────────────────────────────────────────────
# Gemini API (OpenAI 호환 엔드포인트) — 단일 대화창 에이전트(대화형 등록, 지식창고 검색)에 사용
# https://aistudio.google.com/apikey 에서 발급
# ─────────────────────────────────────────────
GEMINI_API_KEY=

# ─────────────────────────────────────────────
# 데이터 경로 — 정책/용어/이용약관은 각각 독립된 JSON 지식창고 파일을 쓴다.
# ─────────────────────────────────────────────
RAW_DATA_DIR=./data/raw
POLICIES_DATA_PATH=./data/knowledge/policies.json
TERMS_DATA_PATH=./data/knowledge/terms.json
TERMS_CONDITIONS_DATA_PATH=./data/knowledge/terms_conditions.json
ACTIVITY_LOG_PATH=./data/knowledge/activity.json
USERS_DATA_PATH=./data/users.json

# 대화 세션은 정책/용어/약관 지식창고와 섞이지 않게 별도 폴더에, 날짜별 파일로 나눠 저장한다.
CHATS_DATA_DIR=./data/chats
# 대화 세션 보관 기간(시간). 이 시간이 지난 세션은 조회에서 제외되고, 다음 쓰기 시점에 파일에서도 삭제된다.
CHAT_RETENTION_HOURS=24

# ─────────────────────────────────────────────
# 로그인 세션 쿠키 서명에 쓰이는 비밀값. 임의의 긴 무작위 문자열로 설정한다.
# ─────────────────────────────────────────────
SESSION_SECRET=

NODE_ENV=development
